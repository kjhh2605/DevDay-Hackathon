# Deployment CLI only. Copy to root .env.deploy.local after local G3 passes.
# This file is not an ECS task env file and contains no access keys.
# S5 wrappers must explicitly pass this profile/region to AWS CLI and CDK.

STUDY_AWS_PROFILE=REPLACE_WITH_PROFILE
STUDY_AWS_ACCOUNT_ID=REPLACE_WITH_12_DIGIT_ACCOUNT_ID
AWS_REGION=ap-northeast-2

# Runtime APP_ENV, DB settings, model IDs, bucket and secrets are supplied
# through CDK outputs / task definitions / Secrets Manager, not this file.

# Speech completion classification (server only); silence boundary is fixed at 10 seconds.
OPENAI_DECISION_MODEL=gpt-6-luna
SPEECH_DECISION_TIMEOUT_MS=2000
SPEECH_DECISION_CONFIDENCE=0.85

# Documentation template. S0 copies this schema to the root .env.example.
# setup:local creates .env.local without overwriting an existing file.
# Keep real keys and generated passwords out of git and Docker build context.
# NODE_ENV is set by dev/test/build commands, not this file.

APP_ENV=local
API_HOST=127.0.0.1
PORT=3000
WEB_PORT=5173

AI_MODE=live
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_LIVE_TRANSCRIBE_MODEL=gpt-live-transcribe
OPENAI_CORRECTION_MODEL=gpt-transcribe
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare-2026-09-08

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=devday_study
DB_USER=devday_app
DB_PASSWORD=REPLACE_WITH_GENERATED_LOCAL_PASSWORD
DB_SSL_MODE=disable
DB_SSL_CA_PATH=
COMPOSE_PROJECT_NAME=devday-study-local

MEDIA_DRIVER=filesystem
MEDIA_LOCAL_DIR=REPLACE_WITH_ABSOLUTE_MEDIA_DIR

LOCAL_WEB_ORIGIN=http://localhost:5173
LOCAL_TLS_CERT=
LOCAL_TLS_KEY=
SESSION_COOKIE_SECURE=false

# Public frontend value. Never put secrets in VITE_* variables.
VITE_API_BASE=/api/v1

# LAN: use the host LAN IP in LOCAL_WEB_ORIGIN, fill TLS paths, set Secure=true.
# API container: override API_HOST=0.0.0.0, DB_HOST=postgres, DB_PORT=5432,
# MEDIA_LOCAL_DIR with the bind mount path, and NODE_ENV=production.

# Speech completion classification (server only); silence boundary is fixed at 10 seconds.
OPENAI_DECISION_MODEL=gpt-6-luna
SPEECH_DECISION_TIMEOUT_MS=2000
SPEECH_DECISION_CONFIDENCE=0.85

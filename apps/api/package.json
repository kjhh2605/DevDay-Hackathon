{
  "name": "@devday/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run test/domain.integration.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "start": "node dist/server.js",
    "dev:lan": "tsx watch src/server.ts"
  },
  "dependencies": {
    "@devday/contracts": "workspace:*",
    "@devday/application-ports": "workspace:*",
    "@devday/ai": "workspace:*",
    "@aws-sdk/client-s3": "^3.888.0",
    "@aws-sdk/s3-request-presigner": "^3.888.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/websocket": "^11.2.0",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "ws": "^8.18.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "esbuild": "^0.28.2"
  }
}
